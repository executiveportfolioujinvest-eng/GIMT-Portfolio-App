NODE_ENV='development'
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Finnhub (https://finnhub.io) — stock search, quotes, profiles and news (server-side only)
FINNHUB_API_KEY=

# MongoDB connection string
MONGODB_URI=

# Better Auth — any long random string, e.g. from: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Gemini — writes the personalised welcome email and daily news summary
GEMINI_API_KEY=

# Gmail account + app password used by Nodemailer to send emails
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Inngest — only needed in production (local dev uses the Inngest dev server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
